# Django
# -------
# DJANGO_SECRET_KEY must be explicitly generated and supplied in every environment.
# Use: python -c "import secrets; print(secrets.token_urlsafe(50))" to generate one.
# Leave blank here so this file cannot be copied directly into a deployment.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
# Production: set DJANGO_ALLOWED_HOSTS to your actual hostnames (comma-separated).
# Example: DJANGO_ALLOWED_HOSTS=myapp.example.com,www.myapp.example.com
# Development (DEBUG=True): falls back to localhost,127.0.0.1,[::1] if not set.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF and Proxy Security
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
DRF_THROTTLE_ANON_RATE=100/day
DRF_THROTTLE_USER_RATE=1000/day
DRF_THROTTLE_AI_HEAVY_RATE=60/minute

# Database
POSTGRES_DB=finpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=finpilot_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Per-Agent Model Assignments
FINANCIAL_MODEL=qwen/qwen3.6-27b
MARKET_MODEL=qwen/qwen3.6-27b
NEWS_MODEL=qwen/qwen3.8-27b
RISK_MODEL=qwen/qwen3.8-27b
PORTFOLIO_MODEL=qwen/qwen3.8-27b
SYNTHESIS_MODEL=qwen/qwen3.8-27b

# Model Tier Defaults
GROQ_MODEL=qwen/qwen3.8-27b
REASONING_MODEL=qwen/qwen3.8-27b
FAST_MODEL=qwen/qwen3.8-27b
EVALUATION_MODEL=qwen/qwen3.8-27b

# Sentiment Analysis
FINANCIAL_SENTIMENT_MODEL=ProsusAI/finbert
FINANCIAL_SENTIMENT_DEVICE=cpu

# Groq Token Budget & Quotas
GROQ_MAX_OUTPUT_TOKENS=1000
GROQ_TPM_LIMIT=
GROQ_TPD_LIMIT=
GROQ_MAX_REQUEST_TOKENS=32768
GROQ_SAFETY_RESERVE_TOKENS=1024
TOOL_CALL_MAX_COMPLETION_TOKENS=4096

# News & Financial Market APIs
NEWS_API_KEY=
TAVILY_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
INDIAN_STOCK_MARKET_API_KEY=
MARKETAUX_API_TOKEN=
UPSTOX_ANALYTICS_ACCESS_TOKEN=

# Vector Database (Qdrant)
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DEVICE=cpu
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finpilot_documents